{
  "name": "editor-ia-starter-kit",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "description": "Starter kit for short-form AI video editing with Claude Code and HyperFrames: inbox in, finals out.",
  "scripts": {
    "new-video": "node scripts/new-video.mjs",
    "inbox": "node scripts/inbox.mjs",
    "deliver": "node scripts/deliver.mjs",
    "projects": "node scripts/projects-index.mjs",
    "transcribe": "node scripts/transcribe-elevenlabs.mjs",
    "whisper-to-kit": "node scripts/whisper-to-kit.mjs",
    "validate-beats": "node scripts/validate-beat-sync.mjs",
    "preflight": "node scripts/preflight.mjs",
    "setup": "node scripts/setup.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check-kit.mjs",
    "catalog": "node scripts/style-library/build-registry.mjs",
    "check:media": "node scripts/check-media.mjs",
    "validate:short-form": "node .claude/skills/short-form-edit/scripts/validate-plan.mjs",
    "validate:footage": "node .claude/skills/short-form-edit/scripts/validate-footage.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "hyperframes": "0.7.109",
    "gsap": "3.14.2"
  }
}
