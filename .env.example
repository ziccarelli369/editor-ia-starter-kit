# Copy this file to .env. Fill only the keys you want to use. Never commit .env.
# Without any key the kit still works: local Whisper transcription and
# motion graphics designed by the agent in HyperFrames.

# Optional. Paid transcription (Scribe) and sound effects.
# https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# Optional. Generated music, stills and B-roll clips (Suno, Seedream, Kling).
# https://docs.kie.ai/
KIE_API_KEY=

# Optional. Path to whisper-cli when it is not on PATH (local, free transcription).
# Example on Windows: C:\Users\you\tools\whisper-cpp\Release\whisper-cli.exe
HYPERFRAMES_WHISPER_PATH=
