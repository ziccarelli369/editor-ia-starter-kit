# Personal inputs, transcripts, edit decisions, and renders stay local.
.env
.env.*
!.env.example
*.env
*.pem
*.key
node_modules/
# Your material never goes in the repo: only the structure does.
inbox/*
!inbox/README.md
outbox/*
!outbox/README.md
video-projects/*
!video-projects/.gitkeep
PROJECTS.md
brands/*
!brands/README.md
!brands/_template/
styles/drafts/*
!styles/drafts/.gitkeep
renders/
**/renders/
**/assets/
tmp/
archives/
*.mp4
*.mov
*.mkv
*.webm
*.wav
*.mp3
*.m4a
*.aac
*.flac
*.zip
*.log
__pycache__/
*.pyc
.DS_Store
Thumbs.db
.vscode/
.claude/settings.local.json

# Deliberately public synthetic timing data, without media.
!examples/short-form/assets/
!examples/short-form/assets/*.json
